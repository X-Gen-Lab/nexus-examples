{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 6
    },
    "configurePresets": [
        {
            "name": "native-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/native.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF",
                "NEXUS_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "stm32-qiming-baremetal",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-qiming-baremetal",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/qiming-baremetal.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF"
            },
            "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "stm32-qiming-freertos",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-qiming-freertos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/qiming-freertos.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF"
            },
            "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "stm32-sky-baremetal",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-sky-baremetal",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/sky-baremetal.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF"
            },
            "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "stm32-sky-freertos",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-sky-freertos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/sky-freertos.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF"
            },
            "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "gd32-liangshan-baremetal",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gd32-liangshan-baremetal",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/liangshan-baremetal.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF"
            },
            "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "gd32-liangshan-freertos",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gd32-liangshan-freertos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/assemblies/liangshan-freertos.json",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_WORKLOAD": "OFF"
            },
            "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake"
        }
    ],
    "buildPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug"
        },
        {
            "name": "stm32-qiming-baremetal",
            "configurePreset": "stm32-qiming-baremetal"
        },
        {
            "name": "stm32-qiming-freertos",
            "configurePreset": "stm32-qiming-freertos"
        },
        {
            "name": "stm32-sky-baremetal",
            "configurePreset": "stm32-sky-baremetal"
        },
        {
            "name": "stm32-sky-freertos",
            "configurePreset": "stm32-sky-freertos"
        },
        {
            "name": "gd32-liangshan-baremetal",
            "configurePreset": "gd32-liangshan-baremetal"
        },
        {
            "name": "gd32-liangshan-freertos",
            "configurePreset": "gd32-liangshan-freertos"
        }
    ],
    "testPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}
