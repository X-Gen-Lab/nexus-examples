{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "examples-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NEXUS_SOURCE": "${sourceDir}/external/nexus",
        "NEXUS_BUILD_TESTS": "OFF",
        "NEXUS_BUILD_CONTRACTS": "OFF"
      }
    },
    {
      "name": "native-debug",
      "inherits": "examples-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NEXUS_PLATFORM": "native",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/native/platform.conf"
      }
    },
    {
      "name": "stm32-discovery-baremetal-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "stm32",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/stm32-discovery-baremetal-release.conf"
      }
    },
    {
      "name": "stm32-discovery-freertos-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "stm32",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/stm32-discovery-freertos-release.conf"
      }
    },
    {
      "name": "stm32-qiming-baremetal-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "stm32",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/stm32-qiming-baremetal-release.conf"
      }
    },
    {
      "name": "stm32-qiming-freertos-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "stm32",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/stm32-qiming-freertos-release.conf"
      }
    },
    {
      "name": "stm32-sky-baremetal-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "stm32",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/stm32-sky-baremetal-release.conf"
      }
    },
    {
      "name": "stm32-sky-freertos-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "stm32",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/stm32-sky-freertos-release.conf"
      }
    },
    {
      "name": "gd32-liangshan-baremetal-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "gd32f470",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/gd32-liangshan-baremetal-release.conf"
      }
    },
    {
      "name": "gd32-liangshan-freertos-release",
      "inherits": "examples-base",
      "toolchainFile": "$env{NEXUS_SOURCE}/cmake/toolchains/arm-gcc.cmake",
      "cacheVariables": {
        "NEXUS_PLATFORM": "gd32f470",
        "NEXUS_CONFIG_FILE": "${sourceDir}/configs/mcu/gd32-liangshan-freertos-release.conf"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "stm32-discovery-baremetal-release",
      "configurePreset": "stm32-discovery-baremetal-release"
    },
    {
      "name": "stm32-discovery-freertos-release",
      "configurePreset": "stm32-discovery-freertos-release"
    },
    {
      "name": "stm32-qiming-baremetal-release",
      "configurePreset": "stm32-qiming-baremetal-release"
    },
    {
      "name": "stm32-qiming-freertos-release",
      "configurePreset": "stm32-qiming-freertos-release"
    },
    {
      "name": "stm32-sky-baremetal-release",
      "configurePreset": "stm32-sky-baremetal-release"
    },
    {
      "name": "stm32-sky-freertos-release",
      "configurePreset": "stm32-sky-freertos-release"
    },
    {
      "name": "gd32-liangshan-baremetal-release",
      "configurePreset": "gd32-liangshan-baremetal-release"
    },
    {
      "name": "gd32-liangshan-freertos-release",
      "configurePreset": "gd32-liangshan-freertos-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
