"""Capture current-pin example preparation; this is not release qualification."""

import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time


ROOT = Path('/workspace/nexus-examples')
OUT = Path(__file__).resolve().parent
PYTHON = '/workspace/nexus/.venv/bin/python'
ENV = dict(os.environ, PATH='/workspace/nexus/.venv/bin:' + os.environ['PATH'])


def identity(path):
    path = Path(path)
    contents = path.read_bytes()
    return {'path': str(path), 'sha256': hashlib.sha256(contents).hexdigest(),
            'bytes': len(contents)}


def write(name, value):
    path = OUT / name
    if path.exists():
        raise ValueError('Never overwrite executed preparation evidence: ' + name)
    path.write_text(json.dumps(value, indent=2) + '\n')
    return identity(path)


def execute(name, argv, timeout=300):
    log = OUT / (name + '.log')
    if log.exists():
        raise ValueError('Never overwrite executed preparation log')
    start = time.time_ns()
    result = subprocess.run(argv, cwd=ROOT, env=ENV, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, timeout=timeout)
    log.write_bytes(result.stdout)
    record = {'argv': argv, 'cwd': str(ROOT), 'exit_code': result.returncode,
              'started_ns': start, 'ended_ns': time.time_ns(),
              'log': identity(log), 'driver': identity(__file__)}
    write(name + '.command.json', record)
    print(name, result.returncode, flush=True)
    return record


def sources():
    suffixes = {'.c', '.h', '.cpp', '.py', '.md', '.toml', '.json', '.yaml', '.yml'}
    names = {ROOT / name for name in ('AGENTS.md', '.pre-commit-config.yaml',
             'CMakeLists.txt', 'CMakePresets.json', 'dependencies/nexus.lock.json')}
    for base in ('apps', 'tests', 'scripts', 'assemblies', 'docs'):
        names.update(p for p in (ROOT / base).rglob('*') if p.is_file() and
                     'evidence' not in p.parts and p.suffix in suffixes)
    names.add(ROOT / 'tests/CMakeLists.txt')
    return {str(p.relative_to(ROOT)): identity(p) for p in sorted(names)}


def audit():
    old = Path('/workspace/nexus-io-implementation-evidence/lifecycle-tdd/'
               'example-io30-freeze.json')
    freeze = json.loads(old.read_text())
    result = {'previous_freeze': identity(old), 'verified': [], 'mismatches': []}
    for name, digest in freeze['files'].items():
        item = identity(ROOT / name)
        result['verified'].append(item)
        if item['sha256'] != digest:
            result['mismatches'].append(name)
    result['qualifies_source_sdk'] = False
    write('fault-policy-incoming-audit.json', result)
    if result['mismatches']:
        raise ValueError('Incoming fault-policy freeze changed')


def tdd():
    before = sources()
    config = ROOT / '.pre-commit-config.yaml'
    green = config.read_bytes()
    marker = b'        pass_filenames: false\n'
    if green.count(marker) != 1:
        raise ValueError('Expected one whole-index TDD hook')
    (OUT / 'hook-green.yaml.raw').write_bytes(green)
    red = green.replace(marker, b'        pass_filenames: true\n')
    (OUT / 'hook-historical-replay.yaml.raw').write_bytes(red)
    try:
        config.write_bytes(red)
        result = execute('hook-historical-replay-red', [PYTHON, '-m', 'unittest',
                         'scripts.test_workflow.ExampleWorkflow.'
                         'test_whole_index_tdd_hook_never_receives_changed_filenames',
                         '-v'])
        if result['exit_code'] != 1:
            raise ValueError('Historical filename contract must fail')
    finally:
        config.write_bytes(green)
    if sources() != before:
        raise ValueError('Replay did not restore exact source bytes')
    result = execute('scripts-green', [PYTHON, '-m', 'unittest', 'discover',
                                      '-s', 'scripts', '-p', 'test_*.py', '-v'])
    if result['exit_code']:
        raise ValueError('Scripts suite failed')
    write('hook-tdd.json', {'kind': 'explicit-historical-hook-replay',
          'historical_order_claimed': False, 'source_before': before,
          'source_after': sources(), 'restored_exact': sources() == before,
          'physical': 'not_executed', 'qualifies_candidate': False})


def pin():
    write('source-before.json', sources())
    execute('sdk-current-pin', [PYTHON, 'scripts/test_repository.py'])
    execute('sdk-current-head', ['git', '-C', 'external/nexus', 'rev-parse', 'HEAD'])
    execute('sdk-current-tree', ['git', '-C', 'external/nexus', 'rev-parse', 'HEAD^{tree}'])
    execute('sdk-current-clean', ['git', '-C', 'external/nexus', 'status', '--porcelain'])
    execute('examples-current-status', ['git', 'status', '--porcelain'])


def build():
    execute('native-current-pin-full-build', [PYTHON, 'scripts/build.py',
            '--preset', 'native-debug', '--test', '--parallel', '1'])
    execute('native-unfiltered-catalogue', ['ctest', '--test-dir',
            str(ROOT / 'build/native-debug'), '--show-only=json-v1'])
    write('source-after-full-build.json', sources())


def partial():
    result = execute('native-applicable-build', ['cmake', '--build',
              str(ROOT / 'build/native-debug'), '--parallel', '1', '--target',
              'owner_lifecycle_test', 'platform_reference', 'sensor_spi',
              'journal', 'modbus_registers'])
    if result['exit_code']:
        raise ValueError('Applicable current-pin target build failed')
    execute('native-current-pin-applicable-ctest', ['ctest', '--test-dir',
            str(ROOT / 'build/native-debug'), '--output-on-failure',
            '--no-tests=error', '--parallel', '1', '-R',
            '^(platform_static_ports|sensor_explicit_spi|persistent_journal|'
            'protocol_authorized_registers|owner_lifecycle_google)$',
            '--output-junit', str(OUT / 'applicable-ctest.xml')])
    google = ROOT / 'build/native-debug/tests/google-execution'
    for name in ('execution.json', 'google-results.xml', 'discovery.log',
                 'execution.log', 'commands.json'):
        (OUT / ('owner-google-' + name)).write_bytes((google / name).read_bytes())
    write('source-after-applicable.json', sources())
    binaries = ROOT / 'build/native-debug'
    write('applicable-artifacts.json', [identity(binaries / name) for name in
          ('tests/owner_lifecycle_test', 'bin/platform_reference',
           'bin/sensor_spi', 'bin/journal', 'bin/modbus_registers')])


if __name__ == '__main__':
    {'audit': audit, 'tdd': tdd, 'pin': pin, 'build': build,
     'partial': partial}[sys.argv[1]]()
